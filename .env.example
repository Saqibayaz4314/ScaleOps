# ScaleOps — SERVER-ONLY variables. Never prefix with NEXT_PUBLIC_.
# AWS credentials are NOT configured here: each user connects their own read-only
# AWS access keys inside the app (Connection page); they are stored AES-256-GCM encrypted.

# PostgreSQL connection string (use a pooled/serverless connection string on Vercel).
DATABASE_URL=postgres://scaleops:change-me@localhost:5432/scaleops

# TLS to the database. Leave unset for local (no TLS) or a CA-signed remote host (verified TLS).
# HEROKU POSTGRES: set to no-verify (its certificate is self-signed). Values: disable | require | no-verify
DATABASE_SSL=

# 32 random bytes, base64. Generate with:  npm run gen:key
# Keep it secret and back it up: losing it makes stored AWS credentials unreadable.
ENCRYPTION_KEY=

# Key rotation: put the OLD key here while you set a new ENCRYPTION_KEY, then have users
# re-save their connection (or re-encrypt) and remove this.
ENCRYPTION_KEY_PREVIOUS=

# Sign-up controls. SIGNUP_ENABLED=false closes registration entirely.
# SIGNUP_INVITE_CODE (min 8 chars), if set, is required to register.
SIGNUP_ENABLED=true
SIGNUP_INVITE_CODE=

